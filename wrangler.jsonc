{
  // Nothing in this file identifies one deployment. The KV namespace is bound by name
  // and created on first deploy. Secrets and variables are set in the Cloudflare
  // dashboard and kept across deploys by keep_vars.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-sheets-claude-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  // Serve only on the Worker's workers.dev address. Preview addresses would serve
  // older and unreleased versions with the same secrets, so they stay off.
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "observability": { "enabled": true }
}
